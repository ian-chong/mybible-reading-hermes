# Supabase project → Project Settings → API. The publishable key is safe in the browser;
# row-level security protects the data. Never put the secret/service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional social sign-in buttons, once each is set up in Supabase → Authentication → Providers.
VITE_AUTH_PROVIDERS=google
